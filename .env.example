# Base da API do ERP (sem barra no final). A LP busca em ${ERP_API_URL}/public/hall-of-fame (sem autenticação).
# Sem esta variável, a LP usa os recordes locais (data/records-local.ts + public/images).
ERP_API_URL="https://api.erp.assessorialpha.com"

# Host do S3 para onde as fotos redirecionam (ex.: nome-do-bucket.s3.amazonaws.com ou *.s3.amazonaws.com).
ERP_IMAGES_HOST=""

# Opcional: secret para o ERP chamar POST /api/revalidate (header x-revalidate-secret) e atualizar na hora.
# Gere com: openssl rand -base64 32
HALL_REVALIDATE_SECRET=""
