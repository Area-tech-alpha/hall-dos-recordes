# API pública do ERP (sem barra no final). A LP busca em ${ERP_API_URL}/public/growth-academy/hall
ERP_API_URL="https://api.seu-erp.com"

# Chave enviada no header x-api-key. Só no servidor: nunca use NEXT_PUBLIC_ aqui.
HALL_API_KEY=""

# Secret que o ERP manda em POST /api/revalidate (header x-revalidate-secret) depois de salvar um recorde.
# Gere com: openssl rand -base64 32
HALL_REVALIDATE_SECRET=""

# Host do storage onde o ERP guarda as fotos e capas (ex.: storage.seu-erp.com ou *.supabase.co).
ERP_IMAGES_HOST=""
